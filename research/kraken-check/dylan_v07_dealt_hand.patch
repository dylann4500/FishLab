     # -- protocol assembly ---------------------------------------------------
+    @staticmethod
+    def _dealt_hand(obs: Observation) -> int:
+        """The hand this seat was DEALT, recovered from the current hand by undoing
+        every public transfer that touched it, newest first.
+
+        Their ``Agent::reset(seat, hand, rules, seed)`` is called by their own
+        driver with the hand as dealt, and their Knowledge marks every card not in
+        it as "somewhere else, never mine".  This bridge used to pass the CURRENT
+        hand and then replay the whole history on top of it, so a card we had
+        taken from an opponent was treated as ours since the deal, and a card we
+        had lost was treated as never ours.  Every certificate their belief
+        builds from an earlier ask ("that seat held a card of this half-suit at
+        that moment") was then built over the wrong candidate set, and the
+        posterior their declarations are gated on was quietly wrong.  Measured on
+        identical deals, that alone was worth about 3.1 sets a game to us.
+        """
+        me = obs.player
+        hand = obs.hand
+        for ev in reversed(obs.history):
+            if isinstance(ev, AskEvent) and ev.success:
+                if ev.asker == me:
+                    hand &= ~(1 << ev.card)
+                elif ev.target == me:
+                    hand |= 1 << ev.card
+            elif isinstance(ev, ClaimEvent):
+                base = ev.half_suit * CARDS_PER_HALF_SUIT
+                for i, holder in enumerate(ev.revealed):
+                    if holder == me:
+                        hand |= 1 << (base + i)
+        return hand
+
